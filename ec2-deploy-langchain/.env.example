# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요 (EC2 에서)
#   cp .env.example .env && chmod 600 .env && nano .env
# - 값에 따옴표("")나 공백을 넣지 마세요
# - $ 는 Compose 가 변수로 해석하므로 비밀번호에 쓰지 마세요 (꼭 써야 하면 $$)

# Docker Hub 아이디 (이미지 이름 앞부분: 아이디/langchain-rag-app)
DOCKERHUB_USERNAME=내_도커허브_아이디
APP_TAG=latest

# OpenAI API 키 (https://platform.openai.com/api-keys)
# - 이 서버 전용 키를 새로 만들고, OpenAI 플랫폼에서 월 사용 한도를 정해 두는 것을 권장
OPENAI_API_KEY=sk-여기에_발급받은_키_입력

# 로그인 계정 (인터넷에 공개되므로 반드시 설정, 비밀번호는 길게)
APP_USERNAME=admin
APP_PASSWORD=여기에_긴_비밀번호_입력

# PDF 업로드 최대 크기 (선택, 기본 20mb)
APP_MAX_FILE_SIZE=20mb

# 접속 포트 (선택)
# - 80   : 이 앱만 올리는 EC2 (http://EC2 IP)
# - 7860 : 메모 앱(ec2-deploy)과 같은 EC2 에 함께 올릴 때 (http://EC2 IP:7860)
HOST_PORT=80
